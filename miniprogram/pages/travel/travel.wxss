/* 出行参考 — Apple 式极简 */

.step {
  margin-top: 32rpx;
}

.step-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.step-number {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--btn);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.step-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.step-desc {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.text-strong {
  color: var(--text);
  font-weight: 600;
}

/* 活动选择 */
.event-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.event-option {
  padding: 26rpx 30rpx;
  border-radius: 20rpx;
}

.event-option.selected {
  border-color: var(--btn);
  box-shadow: 0 0 0 2rpx rgba(0, 113, 227, 0.25);
}

.event-option-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.event-option-date {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--link);
}

.event-option-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.5;
}

.event-option-city {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* 城市选择 */
.city-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface);
  border-radius: 16rpx;
  padding: 26rpx 32rpx;
}

.city-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.picker-icon {
  font-size: 26rpx;
  color: var(--text-3);
}

/* 路线 */
.route-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.route-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
}

.route-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.route-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.route-action {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 24rpx;
  color: var(--link);
}

.route-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
}

/* 提示卡 */
.local-tip {
  margin-top: 32rpx;
  padding: 30rpx 32rpx;
  border-radius: 20rpx;
}

.local-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.local-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
}
