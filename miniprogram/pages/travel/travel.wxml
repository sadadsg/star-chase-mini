<view class="container">
  <view class="page-header">
    <text class="page-title">出行参考</text>
    <text class="page-desc">选择活动与出发城市，生成购票查询链接</text>
  </view>

  <view class="step">
    <view class="step-header">
      <view class="step-number">1</view>
      <text class="step-title">选择你想参加的活动</text>
    </view>

    <view wx:if="{{loading}}" class="loading">
      <view class="loading-spinner"></view>
    </view>

    <view wx:elif="{{events.length === 0}}" class="empty-state">
      <text class="empty-icon">📅</text>
      <text class="empty-text">{{loadFailed ? '数据加载失败' : '暂无活动数据'}}</text>
      <text class="empty-sub" wx:if="{{!loadFailed}}">活动信息从官方公开动态中自动提取</text>
    </view>

    <view wx:else class="event-grid">
      <view
        wx:for="{{events}}"
        wx:key="key"
        class="event-option card {{selectedEvent === index ? 'selected' : ''}}"
        bindtap="selectEvent"
        data-index="{{index}}">
        <view class="event-option-top">
          <text class="badge {{item.badgeClass}}">{{item.typeName}}</text>
          <text class="event-option-date" wx:if="{{item.date}}">{{item.date}}</text>
        </view>
        <text class="event-option-name">{{item.title}}</text>
        <text class="event-option-city">📍 {{item.city}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{activeEvent}}" class="step">
    <view class="step-header">
      <view class="step-number">2</view>
      <text class="step-title">选择你的出发城市</text>
    </view>
    <text class="step-desc">目的地：<text class="text-strong">{{activeEvent.city}}</text></text>
    <picker bindchange="onCityChange" value="{{cityIndex}}" range="{{cities}}">
      <view class="city-picker">
        <text class="city-text">{{fromCity}}</text>
        <text class="picker-icon">▾</text>
      </view>
    </picker>
  </view>

  <view wx:if="{{activeEvent && showRoutes}}" class="step">
    <view class="step-header">
      <view class="step-number">3</view>
      <text class="step-title">{{fromCity}} → {{activeEvent.city}}</text>
    </view>
    <text class="step-desc" wx:if="{{activeEvent.date}}">出发日期建议：{{activeEvent.date}}</text>

    <view class="route-list">
      <view class="route-item card" bindtap="copyRoute" data-type="flight">
        <view class="route-info">
          <text class="route-name">携程 · 机票查询</text>
          <text class="route-desc">{{fromCity}} → {{activeEvent.city}} 直达/中转航班</text>
        </view>
        <text class="route-action">复制链接</text>
      </view>

      <view class="route-item card" bindtap="copyRoute" data-type="train">
        <view class="route-info">
          <text class="route-name">12306 · 车次查询</text>
          <text class="route-desc">{{fromCity}} → {{activeEvent.city}} 高铁/动车</text>
        </view>
        <text class="route-action">复制链接</text>
      </view>
    </view>
    <text class="route-tip">小程序内无法直接打开外部网页，复制链接后在浏览器打开即可购票查询</text>
  </view>

  <view wx:if="{{activeEvent && isLocal}}" class="local-tip card card-tinted">
    <text class="local-title">活动就在{{fromCity}}</text>
    <text class="local-desc">无需跨城出行，按公开信息的时间地点前往即可</text>
  </view>

  <view wx:if="{{activeEvent && !hasDestination}}" class="local-tip card card-tinted">
    <text class="local-title">目的地待定</text>
    <text class="local-desc">该动态暂未公布城市，官方公布后即可生成购票查询链接</text>
  </view>

  <view class="source-note">购票以官方渠道为准，本工具仅生成查询链接{{dataSourceLabel ? ' · ' + dataSourceLabel : ''}}</view>
</view>
