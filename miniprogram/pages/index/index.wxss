/* 首页 — Apple 式极简 */

.hero {
  padding: 72rpx 0 8rpx;
  display: flex;
  flex-direction: column;
}

.hero-date {
  font-size: 26rpx;
  color: var(--text-3);
}

.hero-title {
  margin-top: 14rpx;
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--text);
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text-2);
}

/* 统计条 */
.stats-row {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  padding: 32rpx 0;
  border-radius: 20rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--surface-deep);
}

/* 近期行程 */
.recent-note {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.schedule-item {
  display: flex;
  background: var(--bg);
  border: 1rpx solid var(--hairline);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}

.schedule-date {
  width: 128rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.date-day {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.1;
}

.date-month {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.schedule-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.schedule-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta-time {
  margin-left: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--link);
}

.meta-city {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.schedule-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.5;
}

.schedule-source {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 动态列表 */
.news-list {
  border-top: 1rpx solid var(--hairline);
}

.news-item {
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.news-tags {
  display: flex;
  align-items: center;
}

.news-source {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.news-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.5;
}

.news-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 宫格入口 */
.grid-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.grid-cell {
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 30rpx;
}

.grid-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.grid-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 页脚 */
.footer {
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-note {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.6;
}

.footer-source {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
