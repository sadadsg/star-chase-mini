/* 活动门票 — Apple 式极简（纯文字卡片，无占位图） */

.events-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.event-card {
  background: var(--bg);
  border: 1rpx solid var(--hairline);
  border-radius: 20rpx;
  padding: 30rpx 32rpx;
}

.event-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.event-date {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--link);
}

.event-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
}

.event-meta {
  margin-top: 18rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.meta-label {
  width: 72rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.meta-value {
  font-size: 24rpx;
  color: var(--text-2);
  flex: 1;
}

.event-actions {
  margin-top: 24rpx;
  display: flex;
}

.btn-plain {
  display: inline-block;
  font-size: 26rpx;
  color: var(--text-3);
  padding: 12rpx 28rpx;
  border: 1rpx dashed var(--hairline);
  border-radius: 12rpx;
}
