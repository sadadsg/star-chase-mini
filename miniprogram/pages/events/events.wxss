/* 活动门票页面样式 - 液态玻璃风格 */

.page-header {
  margin-bottom: var(--space-lg);
  padding-bottom: var(--space-md);
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

.page-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* 活动列表 */
.events-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.event-card {
  padding: 0;
  overflow: hidden;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  transition: all 0.2s ease;
}

.event-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.event-cover-wrapper {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

.event-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.event-cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(transparent, rgba(30, 27, 75, 0.3));
}

.event-badge {
  position: absolute;
  top: var(--space-md);
  right: var(--space-md);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-lg);
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255,255,255,0.8);
}

.badge-onsale {
  background: rgba(16, 185, 129, 0.15);
  color: var(--success);
}

.badge-hot {
  background: rgba(236, 72, 153, 0.15);
  color: #EC4899;
}

.badge-soon {
  background: rgba(168, 85, 247, 0.15);
  color: var(--primary);
}

.event-content {
  padding: var(--space-lg);
}

.event-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--space-md);
}

.event-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-right: var(--space-md);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.event-meta {
  margin-bottom: var(--space-lg);
}

.meta-item {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.meta-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  flex-shrink: 0;
}

.meta-icon-purple {
  background: rgba(168, 85, 247, 0.1);
}

.meta-icon-pink {
  background: rgba(236, 72, 153, 0.1);
}

.meta-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.event-actions {
  margin-top: var(--space-lg);
}

.event-btn {
  display: block;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-disabled {
  display: block;
  text-align: center;
  background: rgba(255,255,255,0.3);
  color: var(--text-tertiary);
  padding: 20rpx;
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  background: linear-gradient(135deg, rgba(168,85,247,0.06), rgba(96,165,250,0.04));
  border: 1rpx dashed var(--border);
  padding: var(--space-xl);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: var(--space-md);
  display: block;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-tertiary);
  display: block;
}

/* 统计信息 */
.events-stats {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
}

.stat-card {
  flex: 1;
  padding: var(--space-md);
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 4rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 筛选标签 */
.filter-tags {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
  flex-wrap: wrap;
}

.filter-tag {
  padding: 12rpx 24rpx;
  background: rgba(255,255,255,0.4);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  border: 1rpx solid var(--border);
  transition: all 0.2s ease;
}

.filter-tag.active {
  background: var(--primary);
  color: var(--text-white);
  border-color: var(--primary);
  box-shadow: 0 4rpx 12rpx rgba(168, 85, 247, 0.3);
}

.filter-tag:active {
  transform: scale(0.95);
}
