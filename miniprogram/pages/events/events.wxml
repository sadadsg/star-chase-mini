<view class="container">
  <view class="page-header">
    <text class="page-title">活动门票</text>
    <text class="page-desc">{{artistName}}相关演出与活动汇总</text>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{events.length === 0}}" class="card empty-state">
    <text class="empty-icon">🎫</text>
    <text class="empty-text">{{loadFailed ? '数据加载失败' : '暂无活动'}}</text>
    <text class="empty-sub" wx:if="{{!loadFailed}}">活动信息从官方公开动态中自动提取</text>
  </view>

  <view wx:else class="events-list">
    <view class="event-card" wx:for="{{events}}" wx:key="key">
      <view class="event-top">
        <text class="badge {{item.badgeClass}}">{{item.typeName}}</text>
        <text class="event-date" wx:if="{{item.dateText}}">{{item.dateText}}</text>
      </view>
      <text class="event-name">{{item.name}}</text>
      <view class="event-meta">
        <view class="meta-row">
          <text class="meta-label">城市</text>
          <text class="meta-value">{{item.city}}</text>
        </view>
        <view class="meta-row" wx:if="{{item.source}}">
          <text class="meta-label">来源</text>
          <text class="meta-value">{{item.source}}</text>
        </view>
      </view>
      <view class="event-actions">
        <view wx:if="{{item.newsUrl}}" class="btn-ghost" bindtap="copyLink" data-url="{{item.newsUrl}}">复制来源链接</view>
        <view wx:else class="btn-plain">暂无公开链接</view>
      </view>
    </view>
  </view>

  <view class="source-note" wx:if="{{!loading && events.length > 0}}">
    票务信息以官方渠道为准{{dataSourceLabel ? ' · ' + dataSourceLabel : ''}}
  </view>
</view>
