<view class="container">
  <view class="page-header">
    <text class="page-title">行程日历</text>
    <text class="page-desc">{{artistName}}公开安排 · 点按有圆点的日期查看详情</text>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{loadFailed}}" class="card empty-state">
    <text class="empty-icon">📅</text>
    <text class="empty-text">数据加载失败</text>
    <text class="empty-sub">请检查网络后下拉刷新</text>
  </view>

  <block wx:else>
    <view class="card calendar-card">
      <view class="cal-header">
        <view class="cal-nav" bindtap="prevMonth">‹</view>
        <text class="cal-month">{{year}}年{{month}}月</text>
        <view class="cal-nav" bindtap="nextMonth">›</view>
      </view>

      <view class="cal-stats">
        <text class="cal-stat"><view class="dot dot-filming"></view>影视 {{stats.filming}}</text>
        <text class="cal-stat"><view class="dot dot-variety"></view>综艺 {{stats.variety}}</text>
        <text class="cal-stat"><view class="dot dot-business"></view>商务 {{stats.business}}</text>
        <text class="cal-stat"><view class="dot dot-fanmeeting"></view>演出 {{stats.fanmeeting}}</text>
      </view>

      <view class="cal-weekdays">
        <text class="cal-weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>

      <view class="cal-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="idx"
          class="cal-day {{item.isEmpty ? 'is-empty' : ''}} {{item.isToday ? 'is-today' : ''}} {{item.isSelected ? 'is-selected' : ''}}"
          bindtap="selectDay"
          data-day="{{item.day}}"
          data-date="{{item.date}}">
          <text class="cal-daynum">{{item.day || ''}}</text>
          <view class="cal-dots" wx:if="{{item.events && item.events.length}}">
            <view
              wx:for="{{item.events}}"
              wx:for-item="ev"
              wx:for-index="ei"
              wx:key="key"
              wx:if="{{ei < 3}}"
              class="dot {{ev.dotClass}}"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="day-detail" wx:if="{{selectedDate}}">
      <text class="day-detail-title">{{selectedDate}}</text>
      <view class="day-event" wx:for="{{selectedSchedule}}" wx:key="key">
        <view class="day-event-meta">
          <text class="badge {{item.badgeClass}}">{{item.typeName}}</text>
          <text class="meta-time">{{item.time}}</text>
          <text class="meta-city">{{item.city}}</text>
        </view>
        <text class="day-event-title">{{item.title}}</text>
        <text class="day-event-source" wx:if="{{item.source}}">来源：{{item.source}}</text>
        <text class="day-event-link" wx:if="{{item.newsUrl}}" bindtap="copyLink" data-url="{{item.newsUrl}}">复制原文链接</text>
      </view>
    </view>
  </block>

  <view class="source-note">内容来自官方微博及合作账号的公开信息聚合</view>
</view>
