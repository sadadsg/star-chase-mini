/* 行程日历 — Apple 式极简 */

.calendar-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
}

.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
}

.cal-month {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--text-2);
  border-radius: 50%;
  background: var(--surface);
}

/* 当月分类统计 */
.cal-stats {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.cal-stat {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-2);
}

.cal-stat .dot {
  margin-right: 8rpx;
}

/* 星期行 */
.cal-weekdays {
  display: flex;
  margin-top: 28rpx;
}

.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 日期网格 */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.cal-day {
  width: 14.28%;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.cal-day.is-empty {
  pointer-events: none;
}

.cal-daynum {
  font-size: 28rpx;
  color: var(--text);
}

.cal-day.is-today .cal-daynum {
  color: var(--btn);
  font-weight: 700;
}

.cal-day.is-selected {
  background: var(--surface);
}

.cal-dots {
  display: flex;
  margin-top: 6rpx;
  height: 12rpx;
}

.cal-dots .dot {
  width: 10rpx;
  height: 10rpx;
  margin: 0 3rpx;
}

/* 选中日详情 */
.day-detail {
  margin-top: 32rpx;
}

.day-detail-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
}

.day-event {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.day-event-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta-time {
  margin-left: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--link);
}

.meta-city {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.day-event-title {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.55;
}

.day-event-source {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.day-event-link {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--link);
}
