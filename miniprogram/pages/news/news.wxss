/* 新闻页面样式 - 液态玻璃风格 */

.page-header {
  margin-bottom: var(--space-lg);
  padding-bottom: var(--space-md);
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

.page-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* 数据来源 */
.source-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  background: var(--bg-card);
  border-radius: var(--radius-full);
  margin-bottom: var(--space-lg);
  border: 1rpx solid var(--border);
}

.source-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.source-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--success);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.2); }
}

.source-text {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  background: rgba(168, 85, 247, 0.1);
}

.refresh-icon {
  font-size: 28rpx;
  transition: transform 0.3s ease;
}

.refresh-btn:active .refresh-icon {
  transform: rotate(180deg);
}

/* 新闻列表 */
.news-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.news-item {
  display: flex;
  align-items: flex-start;
  padding: var(--space-lg);
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.news-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(to bottom, var(--primary), #A78BFA);
  border-radius: 0 4rpx 4rpx 0;
}

.news-item:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.news-content {
  flex: 1;
  min-width: 0;
}

.news-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.news-summary {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.news-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.news-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.news-source {
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding: 4rpx 12rpx;
  background: rgba(255,255,255,0.4);
  border-radius: var(--radius-sm);
}

.news-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.news-cover {
  width: 180rpx;
  height: 135rpx;
  border-radius: var(--radius-lg);
  margin-left: var(--space-md);
  flex-shrink: 0;
  object-fit: cover;
}

/* 提示 */
.tips {
  text-align: center;
  padding: var(--space-lg);
  margin-top: var(--space-md);
}

.tips-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tips-icon {
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  background: linear-gradient(135deg, rgba(168,85,247,0.06), rgba(96,165,250,0.04));
  border: 1rpx dashed var(--border);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: var(--space-md);
  display: block;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: var(--space-lg);
}

.empty-btn {
  display: inline-block;
  width: auto;
  padding: 16rpx 40rpx;
}
