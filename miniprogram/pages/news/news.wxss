/* 动态资讯 — Apple 式极简 */

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.filters {
  display: flex;
}

.filter-chip {
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--surface);
}

.filter-chip.active {
  color: #ffffff;
  background: var(--btn);
  font-weight: 500;
}

.refresh-btn {
  font-size: 26rpx;
  color: var(--link);
}

/* 列表 */
.news-list {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--hairline);
}

.news-item {
  padding: 30rpx 4rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.news-tags {
  display: flex;
  align-items: center;
}

.news-category {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--surface);
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
}

.news-source {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.news-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
}

.news-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.55;
}

.news-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.news-time {
  font-size: 22rpx;
  color: var(--text-3);
}

.news-copy-hint {
  font-size: 22rpx;
  color: var(--text-3);
}
