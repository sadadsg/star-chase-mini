<view class="container">
  <view class="page-header">
    <text class="page-title">动态资讯</text>
    <text class="page-desc">{{artistName}}相关公开动态聚合</text>
  </view>

  <view class="toolbar">
    <view class="filters">
      <text class="filter-chip {{filter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">全部</text>
      <text class="filter-chip {{filter === 'official' ? 'active' : ''}}" bindtap="setFilter" data-filter="official">官方 {{officialCount}}</text>
    </view>
    <view class="refresh-btn" bindtap="refreshNews">↻ 刷新</view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{news.length === 0}}" class="card empty-state">
    <text class="empty-icon">📰</text>
    <text class="empty-text">{{loadFailed ? '数据加载失败' : (filter === 'official' ? '暂无官方动态' : '暂无相关动态')}}</text>
    <text class="empty-sub" wx:if="{{!loadFailed}}">下拉刷新试试</text>
    <view class="btn-primary empty-btn" bindtap="refreshNews" wx:if="{{loadFailed}}">重新加载</view>
  </view>

  <view wx:else class="news-list">
    <view class="news-item" wx:for="{{news}}" wx:key="key" bindtap="copyLink" data-url="{{item.url}}">
      <view class="news-item-main">
        <view class="news-tags">
          <text wx:if="{{item.isOfficial}}" class="badge-official">官方</text>
          <text wx:if="{{item.category}}" class="news-category">{{item.category}}</text>
          <text class="news-source">{{item.source}}</text>
        </view>
        <text class="news-title">{{item.title}}</text>
        <text class="news-summary" wx:if="{{item.summary && item.summary !== item.title}}">{{item.summary}}</text>
        <view class="news-meta">
          <text class="news-time">{{item.time}}</text>
          <text class="news-copy-hint">点击复制链接</text>
        </view>
      </view>
    </view>
  </view>

  <view class="source-note" wx:if="{{!loading && news.length > 0}}">
    共 {{total}} 条 · 来源：官方微博及合作账号公开信息{{dataSourceLabel ? ' · ' + dataSourceLabel : ''}}
  </view>
</view>
