/* ============================================================
   嘉期如梦 设计系统 v2 — Apple.com 式极简
   与 Web 版 src/index.css 同源色板：白/浅灰实底分段、
   发丝线分隔、系统字体栈、大留白、无玻璃拟态、无渐变
   ============================================================ */

page {
  --bg: #ffffff;
  --surface: #f5f5f7;
  --surface-deep: #e8e8ed;
  --text: #1d1d1f;
  --text-2: #6e6e73;
  --text-3: #86868b;
  --hairline: #d2d2d7;
  --link: #0066cc;
  --btn: #0071e3;
  --btn-hover: #0077ed;

  --t-filming: #5856d6;
  --t-variety: #248a3d;
  --t-business: #b45309;
  --t-fanmeeting: #d6336c;
  --t-default: #6e6e73;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

.container {
  padding: 0 40rpx 60rpx;
}

/* ---------- 通用卡片 ---------- */
.card {
  background: var(--bg);
  border-radius: 20rpx;
  border: 1rpx solid var(--hairline);
  padding: 32rpx;
  box-sizing: border-box;
}

.card-tinted {
  background: var(--surface);
  border: none;
}

/* ---------- 分段标题 ---------- */
.section {
  margin-top: 56rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 1rpx;
}

.section-link {
  font-size: 26rpx;
  color: var(--link);
}

/* ---------- 页头（非首页） ---------- */
.page-header {
  padding: 48rpx 0 8rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text);
}

.page-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

/* ---------- 类型徽章（四档语义色 + 默认灰档） ---------- */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
  font-weight: 500;
}

.badge-filming { color: var(--t-filming); background: rgba(88, 86, 214, 0.10); }
.badge-variety { color: var(--t-variety); background: rgba(36, 138, 61, 0.10); }
.badge-business { color: var(--t-business); background: rgba(180, 83, 9, 0.10); }
.badge-fanmeeting { color: var(--t-fanmeeting); background: rgba(214, 51, 108, 0.10); }
.badge-default { color: var(--t-default); background: rgba(110, 110, 115, 0.10); }

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
}

.dot-filming { background: var(--t-filming); }
.dot-variety { background: var(--t-variety); }
.dot-business { background: var(--t-business); }
.dot-fanmeeting { background: var(--t-fanmeeting); }
.dot-default { background: var(--t-default); }

/* 官方来源徽章 */
.badge-official {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--btn);
  border: 1rpx solid rgba(0, 113, 227, 0.35);
}

/* ---------- 按钮 ---------- */
.btn-primary {
  display: block;
  text-align: center;
  background: var(--btn);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 14rpx;
  padding: 20rpx 0;
}

.btn-primary:active { background: var(--btn-hover); }

.btn-ghost {
  display: inline-block;
  text-align: center;
  border: 1rpx solid var(--hairline);
  color: var(--link);
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 12rpx 28rpx;
}

/* ---------- 加载 / 空态 / 错误态 ---------- */
.loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--surface-deep);
  border-top-color: var(--text-3);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 32rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
  text-align: center;
}

.empty-btn {
  margin-top: 32rpx;
  width: 320rpx;
}

/* ---------- 数据来源说明 ---------- */
.source-note {
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--hairline);
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
}

/* ---------- 意见反馈按钮（原生能力，样式还原为文字链） ---------- */
.feedback-btn {
  margin: 24rpx auto 0;
  display: block;
  width: 320rpx;
  background: transparent;
  border: 1rpx solid var(--hairline);
  border-radius: 999rpx;
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 2.2;
  padding: 0;
}

.feedback-btn::after { border: none; }
