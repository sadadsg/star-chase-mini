/* 嘉期如梦 - 液态玻璃风格 */
/* 与 web 版统一的视觉标准 */

/* ========== 设计令牌 ========== */
page {
  /* 主色调 - 薰衣草紫 */
  --primary: #C084FC;
  --primary-light: #D8B4FE;
  --primary-lighter: #FAF5FF;
  --primary-dark: #A855F7;
  
  /* 辅助色 - 天蓝 */
  --accent: #60A5FA;
  --accent-light: #DBEAFE;
  --accent-lighter: #EFF6FF;
  
  /* 功能色 */
  --success: #34D399;
  --success-light: #D1FAE5;
  --warning: #FBBF24;
  --warning-light: #FEF3C7;
  --info: #60A5FA;
  --info-light: #DBEAFE;
  
  /* 中性色 */
  --text-primary: #1E1B4B;
  --text-secondary: #4B5563;
  --text-tertiary: #9CA3AF;
  --text-white: #FFFFFF;
  
  /* 背景色 */
  --bg-page: linear-gradient(135deg, #EDE9FE 0%, #FCE7F3 35%, #E0F2FE 70%, #F0FDF4 100%);
  --bg-card: rgba(255, 255, 255, 0.6);
  --bg-elevated: rgba(255, 255, 255, 0.75);
  --bg-glass: rgba(255, 255, 255, 0.55);
  
  /* 边框色 */
  --border: rgba(255, 255, 255, 0.5);
  --border-light: rgba(255, 255, 255, 0.3);
  
  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --radius-full: 999rpx;
  
  /* 阴影 */
  --shadow-sm: 0 4rpx 16rpx rgba(139, 92, 246, 0.06);
  --shadow-md: 0 8rpx 32rpx rgba(139, 92, 246, 0.08);
  --shadow-lg: 0 16rpx 48rpx rgba(139, 92, 246, 0.1);
  
  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  
  /* 基础设置 */
  background: linear-gradient(135deg, #EDE9FE 0%, #FCE7F3 35%, #E0F2FE 70%, #F0FDF4 100%);
  background-attachment: fixed;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Noto Sans SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

/* ========== 基础组件 ========== */

/* 容器 */
.container {
  padding: var(--space-lg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 液态玻璃卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
}

.card-glass {
  background: var(--bg-glass);
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--border);
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: var(--text-white);
  border-radius: var(--radius-xl);
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  text-align: center;
  display: block;
  box-shadow: 0 8rpx 24rpx rgba(168, 85, 247, 0.3);
  transition: all 0.2s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(168, 85, 247, 0.2);
}

.btn-secondary {
  background: var(--primary-lighter);
  color: var(--primary);
  border-radius: var(--radius-xl);
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: none;
  text-align: center;
  display: block;
}

.btn-ghost {
  background: transparent;
  color: var(--primary);
  border-radius: var(--radius-xl);
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: 1rpx solid var(--primary-light);
  text-align: center;
  display: block;
}

/* ========== 文字样式 ========== */

.text-primary {
  color: var(--primary);
}

.text-accent {
  color: var(--accent);
}

.text-gray {
  color: var(--text-secondary);
}

.text-dark {
  color: var(--text-primary);
}

.text-light {
  color: var(--text-tertiary);
}

/* ========== 徽章 ========== */

.badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-lg);
  font-size: 22rpx;
  font-weight: 500;
}

.badge-purple {
  background: rgba(168, 85, 247, 0.1);
  color: var(--primary);
}

.badge-pink {
  background: rgba(236, 72, 153, 0.1);
  color: #EC4899;
}

.badge-green {
  background: rgba(16, 185, 129, 0.1);
  color: var(--success);
}

.badge-orange {
  background: rgba(245, 158, 11, 0.1);
  color: var(--warning);
}

.badge-blue {
  background: rgba(59, 130, 246, 0.1);
  color: var(--accent);
}

.badge-onsale {
  background: rgba(16, 185, 129, 0.1);
  color: var(--success);
}

/* ========== 加载动画 ========== */

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s ease-in-out infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 骨架屏闪烁 */
.shimmer {
  background: linear-gradient(90deg, 
    rgba(255,255,255,0.3) 25%, 
    rgba(255,255,255,0.5) 50%, 
    rgba(255,255,255,0.3) 75%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ========== 空状态 ========== */

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  display: block;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-tertiary);
  display: block;
}

.empty-btn {
  margin-top: 32rpx;
}

/* ========== 标题样式 ========== */

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.section-link {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

/* ========== 分割线 ========== */

.divider {
  height: 1rpx;
  background: var(--border);
  margin: var(--space-md) 0;
}

/* ========== 溢出隐藏 ========== */

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ========== 渐变文字 ========== */

.gradient-text {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ========== 页面标题 ========== */

.page-header {
  margin-bottom: var(--space-lg);
  padding-bottom: var(--space-md);
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

.page-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* ========== 列表项 ========== */

.list-item {
  display: flex;
  align-items: center;
  padding: var(--space-md);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-sm);
  border: 1rpx solid var(--border);
}

.list-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* ========== 标签 ========== */

.tag {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-md);
  font-size: 22rpx;
  font-weight: 500;
}

.tag-purple {
  background: rgba(168, 85, 247, 0.1);
  color: var(--primary);
}

.tag-pink {
  background: rgba(236, 72, 153, 0.1);
  color: #EC4899;
}

/* ========== 动画效果 ========== */

.fade-in-up {
  animation: fadeInUp 0.5s ease-out;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.scale-in {
  animation: scaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}
